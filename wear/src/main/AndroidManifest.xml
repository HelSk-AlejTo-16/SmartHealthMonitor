<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permisos necesarios para sensores y monitorización de salud -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <uses-permission android:name="android.permission.BODY_SENSORS_BACKGROUND" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- Requerido por la Wearable Data Layer API en ambos lados (reloj y teléfono) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Permiso de Health Connect necesario en versiones recientes para ritmo cardiaco -->
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />


    <!-- El hardware necesario es el reloj -->
    <uses-feature android:name="android.hardware.type.watch" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <uses-library
            android:name="com.google.android.wearable"
            android:required="true" />
        <uses-library
            android:name="wear-sdk"
            android:required="false" />

        <!--
            BUG #3 CORREGIDO:
            standalone="true" indica que la app del reloj NO necesita la app del teléfono,
            lo que puede impedir la comunicación con el móvil.
            Cambiado a false para habilitar correctamente la sincronización.
        -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />

        <!-- Actividad Principal -->
        <activity
            android:name="mx.utng.smarthealthmonitor.wear.presentation.WearMainActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/MainActivityTheme.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            BUG #4 CORREGIDO:
            android:permission="com.google.android.wearable.permission.BIND_LISTENER" es
            un permiso incorrecto para un PassiveListenerService. Al aplicarlo, el sistema
            Health Services no puede enlazarse al servicio y nunca recibe datos de FC.
            Se elimina ese atributo para que Health Services pueda invocarlo libremente.
        -->
        <service
            android:name="mx.utng.smarthealthmonitor.wear.watchface.SmartHealthWatchFaceService"
            android:exported="true"
            android:label="SmartHealth Watch Face"
            android:permission="android.permission.BIND_WALLPAPER">
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/watch_face" />
            <meta-data
                android:name="com.google.android.wearable.watchface.preview"
                android:resource="@drawable/preview_digital" />
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
                <category android:name="com.google.android.wearable.watchface.category.WATCH_FACE" />
            </intent-filter>
        </service>

        <!-- HealthDataService: recibe datos de Health Services en segundo plano -->
        <service
            android:name="mx.utng.latp.wear.presentation.healthMonitor.wear.HealthDataService"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.services.client.PASSIVE_LISTENER" />
            </intent-filter>
        </service>

    </application>

</manifest>
